# PostgreSQL
POSTGRES_USER=racion
POSTGRES_PASSWORD=racion
POSTGRES_DB=racion

# Backend
DATABASE_URL=postgres://racion:racion@db:5432/racion?sslmode=disable
HTTP_ADDR=:8080

# Frontend (build-time)
# Счётчик Яндекс Метрики: приложение (сборка фронта) и SSR-страницы (сервер читает как METRIKA_ID)
VITE_METRIKA_ID=

# Порт Postgres на хосте (в контейнере всегда 5432). 5433 — чтобы не конфликтовать с локальным Postgres.
DB_PORT=5433
WEB_PORT=8090
HF_TOKEN=            # токен Hugging Face для генерации фото рецептов (scripts/gen_images.py), локально

# Логи бэкенда: уровень и формат (json для сервера, console для разработки)
LOG_LEVEL=info
LOG_FORMAT=json

# Контакт оператора для Web Push (VAPID), его видят push-сервисы Google и Mozilla
PUSH_CONTACT=mailto:admin@racion.app

# Публичный адрес сайта: canonical, sitemap, ссылки в уведомлениях и превью для мессенджеров.
# Пусто — берётся из заголовков запроса (для разработки на localhost).
BASE_URL=https://racion.app

# OpenAI: переводы локалей и рецептов (go run ./cmd/racionai) и кнопка «улучшить рецепт» в приложении.
# Пусто — функции ИИ выключены. gpt-5-nano — дешёвая модель, её хватает.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Почты администраторов через запятую: им открыта панель /admin (пользователи, аналитика, ошибки, логи)
ADMIN_EMAILS=

# Фото (S3/MinIO). В докере MinIO поднимается сам; для внешнего S3 укажите свой endpoint и ключи.
# Ссылки на фото публикуются относительно S3_PUBLIC_URL: /media проксируется nginx в MinIO.
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=racion
S3_SECRET_KEY=racion-secret
S3_BUCKET=racion
S3_PUBLIC_URL=/media

# Локальные утилиты (cmd/racionai): переводы через Codex CLI по подписке ChatGPT; пусто — codex из PATH
CODEX_BIN=

# Нейросети: сервер собирает пул из всех заданных ключей (порядок AI_ORDER, по умолчанию mistral,gemini,groq,openrouter,openai,local)
# и использует их для переводов своих рецептов, автопроверки и помощника; те же ключи — для cmd/racionai -backend …
# MISTRAL_API_KEY=      # console.mistral.ai → API keys, тариф Experiment: ~1 млрд токенов в месяц, 1 запрос/с
# GEMINI_API_KEY=       # aistudio.google.com → Get API key, flash-lite: 1000 запросов в день
# GROQ_API_KEY=         # console.groq.com
# OPENROUTER_API_KEY=   # openrouter.ai/keys, модели :free — 50 запросов в день без кредитов
# AI_BASE_URL=          # для custom: любой OpenAI-совместимый /v1
# AI_API_KEY=
# AI_MODEL=
# AI_ORDER=mistral,gemini,openai   # порядок провайдеров на сервере
# AI_MODELS=mistral=ministral-14b-latest,gemini=gemini-2.5-flash-lite   # переопределить модели
